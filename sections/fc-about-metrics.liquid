{{ 'fc-about-metrics.css' | asset_url | stylesheet_tag }}

<section class="fc-about-metrics" aria-labelledby="AboutMetricsHeading-{{ section.id }}">
  <h2 id="AboutMetricsHeading-{{ section.id }}" class="fc-about-metrics__section-heading">FreshClub by the numbers</h2>
  <div class="fc-about-metrics__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fc-about-metrics__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <div class="fc-about-metrics__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'metric' -%}
            <div class="fc-about-metrics__item" {{ block.shopify_attributes }}>
              <p class="fc-about-metrics__value">{{ block.settings.value | escape }}</p>
              <h3 class="fc-about-metrics__heading">{{ block.settings.heading | escape }}</h3>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About — Metrics",
  "tag": "section",
  "class": "section-fc-about-metrics",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FRESHCLUB BY THE NUMBERS"
    }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "50"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Orders capped per day, so nothing gets rushed"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Metrics",
      "blocks": [
        {
          "type": "metric",
          "settings": {
            "value": "50",
            "heading": "Orders capped per day, so nothing gets rushed"
          }
        },
        {
          "type": "metric",
          "settings": {
            "value": "4AM",
            "heading": "At Sydney’s markets every single morning"
          }
        },
        {
          "type": "metric",
          "settings": {
            "value": "$0",
            "heading": "In hidden fees or surprise charges"
          }
        },
        {
          "type": "metric",
          "settings": {
            "value": "100%",
            "heading": "Freshness guarantee on every delivery"
          }
        }
      ]
    }
  ]
}
{% endschema %}
