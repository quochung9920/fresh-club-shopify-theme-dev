{% liquid
  assign section_id = 'multiple-steps-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="multiple-steps-section color-{{ section.settings.color_scheme }} gradient"
  style="--ms-padding-top: {{ section.settings.padding_top }}px; --ms-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="multiple-steps page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <{% if section.index == 1 %}h1{% else %}h2{% endif %} class="multiple-steps__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </{% if section.index == 1 %}h1{% else %}h2{% endif %}>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="multiple-steps__subheading rte {{ section.settings.subheading_size }}">
        {{ section.settings.subheading }}
      </div>
    {%- endif -%}

    <div class="multiple-steps__list">
      {%- for block in section.blocks -%}
        {%- assign step_number = forloop.index -%}
        {%- if step_number < 10 -%}
          {%- assign step_number = '0' | append: step_number -%}
        {%- endif -%}

        <article
          class="multiple-steps__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          <div class="multiple-steps__number" style="background-color: {{ block.settings.number_bg }};">
            <span>{{ step_number }}</span>
          </div>

          <div class="multiple-steps__content">
            <div class="multiple-steps__title-wrap">
              {%- if block.settings.icon_svg != blank -%}
                <span class="multiple-steps__icon" aria-hidden="true">
                  {{ block.settings.icon_svg }}
                </span>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="multiple-steps__title {{ block.settings.title_size }}">{{ block.settings.title }}</h3>
              {%- endif -%}
            </div>

            {%- if block.settings.description != blank -%}
              <div class="multiple-steps__description rte {{ block.settings.description_size }}">
                {{ block.settings.description }}
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #{{ section_id }} {
  	padding-top: var(--ms-padding-top);
  	padding-bottom: var(--ms-padding-bottom);
  }

  #{{ section_id }} .multiple-steps__heading {
  	margin: 0 auto;
  	margin-bottom: 1.6rem;
  	color: rgb(var(--color-foreground));
  	text-align: center;
  }

  #{{ section_id }} .multiple-steps__subheading {
  	margin: 0 auto 5.4rem;
  	color: rgba(var(--color-foreground), 0.75);
  	text-align: center;
  }

  #{{ section_id }} .multiple-steps__subheading p {
  	margin: 0;
  }

  #{{ section_id }} .multiple-steps__list {
  	display: grid;
  	gap: {{ section.settings.step_list_gap }}px;
  }

  #{{ section_id }} .multiple-steps__item {
  	background: #fff;
  	border-radius: {{ section.settings.step_corner_radius }}px;
  	overflow: hidden;
  	display: grid;
  	grid-template-columns: 9rem minmax(0, 1fr);
  	align-items: stretch;
  	box-shadow: 0 0.2rem 0 rgba(0, 0, 0, 0.02);
  	gap: 2.6rem;
  }

  #{{ section_id }} .multiple-steps__number {
  	display: flex;
  	align-items: center;
  	justify-content: center;
  	color: #fff;
  	font-size: clamp(2.2rem, 2.5vw, 3rem);
  	font-weight: 800;
  	line-height: 1.6;
  }

  #{{ section_id }} .multiple-steps__content {
  	padding: 2.6rem 2.8rem 2.6rem 0.4rem;
  }

  #{{ section_id }} .multiple-steps__title-wrap {
  	display: flex;
  	align-items: center;
  	gap: 1rem;
  	margin-bottom: 0.8rem;
  }

  #{{ section_id }} .multiple-steps__icon {
  	width: 2.2rem;
  	height: 2.2rem;
  	display: inline-flex;
  	flex: 0 0 2.2rem;
  	align-items: center;
  	justify-content: center;
  }

  #{{ section_id }} .multiple-steps__icon svg {
  	width: 100%;
  	height: 100%;
  	display: block;
  	object-fit: contain;
  	stroke: rgb(var(--color-button));
  	fill: none;
  	stroke-width: 2;
  }

  #{{ section_id }} .multiple-steps__title {
  	margin: 0;
  	color: rgb(var(--color-foreground));
  }

  #{{ section_id }} .multiple-steps__description {
  	color: rgba(var(--color-foreground), 0.75);
  }

  @media screen and (max-width: 749px) {
  	#{{ section_id }} .multiple-steps__item {
  		grid-template-columns: 6.4rem minmax(0, 1fr);
  		gap: 1.6rem;
  	}
  }
{% endstyle %}

