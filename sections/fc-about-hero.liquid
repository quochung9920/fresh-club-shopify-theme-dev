{{ 'fc-about-hero.css' | asset_url | stylesheet_tag }}

<section class="fc-about-hero" aria-labelledby="AboutHeroHeading-{{ section.id }}">
  <div class="fc-about-hero__inner">
    <div class="fc-about-hero__lede">
      <div class="fc-about-hero__copy">
        <h1 id="AboutHeroHeading-{{ section.id }}" class="fc-about-hero__heading">{{ section.settings.heading }}</h1>
        <p class="fc-about-hero__text">{{ section.settings.text | escape }}</p>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="fc-about-hero__actions">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'button' -%}
                {%- if block.settings.heading != blank and block.settings.link != blank -%}
                  {%- if block.settings.style == 'primary' -%}
                    <a class="button button--primary fc-about-hero__action" href="{{ block.settings.link | escape }}" {{ block.shopify_attributes }}>
                      {{- block.settings.heading | escape -}}
                    </a>
                  {%- elsif block.settings.style == 'secondary' -%}
                    <a class="button button--secondary fc-about-hero__action" href="{{ block.settings.link | escape }}" {{ block.shopify_attributes }}>
                      {{- block.settings.heading | escape -}}
                    </a>
                  {%- endif -%}
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="fc-about-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2560
          | image_tag:
            class: 'fc-about-hero__image',
            widths: '375, 550, 750, 1100, 1500, 2000, 2560',
            sizes: '(min-width: 1024px) 1280px, calc(100vw - 40px)',
            alt: section.settings.image_alt,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        <img
          class="fc-about-hero__image"
          src="{{ 'freshclub-about-hero-base.jpg' | asset_img_url: '750x' }}"
          srcset="
            {{ 'freshclub-about-hero-base.jpg' | asset_img_url: '375x' }} 375w,
            {{ 'freshclub-about-hero-base.jpg' | asset_img_url: '550x' }} 550w,
            {{ 'freshclub-about-hero-base.jpg' | asset_img_url: '750x' }} 750w,
            {{ 'freshclub-about-hero-base.jpg' | asset_img_url: '1100x' }} 1100w,
            {{ 'freshclub-about-hero-base.jpg' | asset_img_url: '1500x' }} 1500w,
            {{ 'freshclub-about-hero-base.jpg' | asset_img_url: '2000x' }} 2000w,
            {{ 'freshclub-about-hero-base.jpg' | asset_img_url: '2560x' }} 2560w
          "
          sizes="(min-width: 1024px) 1280px, calc(100vw - 40px)"
          alt="{{ section.settings.image_alt | escape }}"
          width="2731"
          height="4096"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
      <img
        class="fc-about-hero__overlay"
        src="{{ 'freshclub-about-hero-overlay.jpg' | asset_url }}"
        alt=""
        width="2880"
        height="1920"
        loading="eager"
        aria-hidden="true"
      >
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About — Hero",
  "tag": "section",
  "class": "section-fc-about-hero",
  "max_blocks": 2,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The Local Team Making Fresh Produce Simple For Sydney Businesses"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "FreshClub started with a simple idea: buying wholesale fruit & veg shouldn’t mean 4am market runs, phone tag, or surprise prices. We’re a Sydney-based team connecting food businesses directly to the freshest stock — with honest pricing and delivery you can count on."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Fresh produce at Sydney’s markets"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Action",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Start Your Order"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Hero",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "heading": "Start Your Order",
            "link": "shopify://collections/all",
            "style": "primary"
          }
        },
        {
          "type": "button",
          "settings": {
            "heading": "View Products",
            "link": "shopify://collections/all",
            "style": "secondary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
