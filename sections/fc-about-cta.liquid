{{ 'fc-about-cta.css' | asset_url | stylesheet_tag }}

<div class="fc-about-cta" data-section-id="{{ section.id }}">
  <div class="fc-about-cta__banner">
    <div class="fc-about-cta__background" aria-hidden="true">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 1600
          | image_tag:
            class: 'fc-about-cta__background-image',
            alt: '',
            loading: 'eager',
            sizes: '(min-width: 1024px) 1280px, calc(100vw - 40px)',
            widths: '335, 670, 960, 1280, 1600'
        }}
      {%- else -%}
        <img
          class="fc-about-cta__background-image"
          src="{{ 'freshclub-about-cta-bg.png' | asset_url }}"
          alt=""
          width="740"
          height="740"
          loading="eager"
        >
      {%- endif -%}
    </div>

    <div class="fc-about-cta__decoration fc-about-cta__decoration--left" aria-hidden="true">
      <img
        src="{{ 'freshclub-about-cta-decoration.png' | asset_url }}"
        alt=""
        width="206"
        height="165"
        loading="eager"
      >
    </div>
    <div class="fc-about-cta__decoration fc-about-cta__decoration--right" aria-hidden="true">
      <img
        src="{{ 'freshclub-about-cta-decoration.png' | asset_url }}"
        alt=""
        width="206"
        height="165"
        loading="eager"
      >
    </div>

    <div class="fc-about-cta__copy">
      <div class="fc-about-cta__title-group">
        {%- if section.settings.heading != blank -%}
          <h2 class="fc-about-cta__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="fc-about-cta__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.text != blank -%}
        <div class="fc-about-cta__text">{{ section.settings.text | escape | newline_to_br }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      {%- assign button_url = section.settings.button_link | default: routes.all_products_collection_url -%}
      {%- case section.settings.button_style -%}
        {%- when 'primary' -%}
          {%- assign button_class = 'button button--primary' -%}
        {%- when 'secondary' -%}
          {%- assign button_class = 'button button--secondary' -%}
        {%- else -%}
          {%- assign button_class = 'button button--primary' -%}
      {%- endcase -%}
      <a
        class="{{ button_class }}"
        href="{{ button_url | escape }}"
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "About — Call to action",
  "tag": "section",
  "class": "fc-about-cta-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join The Club. Buy Fresher, For Less."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Local team. Honest prices. Market-fresh every day."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Whether you run a restaurant, cafe, catering company, juice bar, grocer, or office — FreshClub delivers the same wholesale access, quality assurance, and simplicity trusted by Sydney’s leading businesses."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Ordering Fresh"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    }
  ],
  "presets": [
    { "name": "About — Call to action" }
  ]
}
{% endschema %}
