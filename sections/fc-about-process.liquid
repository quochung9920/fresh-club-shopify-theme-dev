{{ 'fc-about-process.css' | asset_url | stylesheet_tag }}

<div class="fc-about-process" data-section-id="{{ section.id }}">
  <div class="fc-about-process__inner page-width">
    <header class="fc-about-process__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="fc-about-process__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="fc-about-process__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    <ol class="fc-about-process__steps">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'process_step' -%}
            {%- assign badge_is_time = false -%}
            {%- assign badge_value = block.settings.badge | downcase -%}
            {%- if badge_value contains 'am' or badge_value contains 'pm' -%}
              {%- assign badge_is_time = true -%}
            {%- endif -%}
            <li class="fc-about-process__step" {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}
                <div class="fc-about-process__badge{% if badge_is_time %} fc-about-process__badge--time{% endif %}">
                  {{- block.settings.badge | escape -}}
                </div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="fc-about-process__step-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="fc-about-process__step-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
        {%- endcase -%}
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "About — Daily process",
  "tag": "section",
  "class": "fc-about-process-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A day at FreshClub"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Introduction",
      "default": "What happens between the market floor and your kitchen door."
    }
  ],
  "blocks": [
    {
      "type": "process_step",
      "name": "Process step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "4AM"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The market run"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We’re on the floor at Sydney’s produce markets, hand-picking your stock."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Daily process",
      "blocks": [
        {
          "type": "process_step",
          "settings": {
            "badge": "TONIGHT",
            "heading": "You place your order",
            "text": "Browse live stock photos and honest prices, then lock in tomorrow’s delivery slot."
          }
        },
        {
          "type": "process_step",
          "settings": {
            "badge": "4AM",
            "heading": "The market run",
            "text": "We’re on the floor at Sydney’s produce markets, hand-picking your stock."
          }
        },
        {
          "type": "process_step",
          "settings": {
            "badge": "6AM",
            "heading": "Checked & packed",
            "text": "Our own crew quality-checks and packs every single box — no shortcuts."
          }
        },
        {
          "type": "process_step",
          "settings": {
            "badge": "YOUR SLOT",
            "heading": "Delivered fresh",
            "text": "Your order arrives in your chosen window, picked just hours earlier."
          }
        }
      ]
    }
  ]
}
{% endschema %}
