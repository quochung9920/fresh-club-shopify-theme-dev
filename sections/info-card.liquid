{%- liquid
  assign info_card_id = 'info-card-' | append: section.id
-%}

{%- style -%}
  #{{ info_card_id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #{{ info_card_id }} .info-card {
    background: rgb(var(--color-background));
    border-radius: {{ section.settings.container_corner_radius }}px;
    padding: 4rem 2.4rem;
    color: rgb(var(--color-foreground));
  }

  #{{ info_card_id }} .info-card__heading {
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
    color: rgb(var(--color-foreground));
  }

  #{{ info_card_id }} .info-card__header--left {
    text-align: left;
  }

  #{{ info_card_id }} .info-card__header--center {
    text-align: center;
  }

  #{{ info_card_id }} .info-card__header--right {
    text-align: right;
  }

  #{{ info_card_id }} .info-card__subheading {
    margin: 0 0 {{ section.settings.subheading_margin_bottom }}px;
    color: rgba(var(--color-foreground), 0.75);
  }

  #{{ info_card_id }} .info-card__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }

  {% if section.settings.card_show_container %}
    #{{ info_card_id }} .info-card__item {
      background: rgba(var(--color-foreground), 0.06);
      border: 0.1rem solid rgba(var(--color-foreground), 0.2);
      border-radius: {{ section.settings.card_border_radius }}px;
      padding: 2.4rem 2.2rem;
      height: 100%;
    }
  {% endif %}

  #{{ info_card_id }} .info-card__item--left {
    text-align: left;
  }

  #{{ info_card_id }} .info-card__item--center {
    text-align: center;
  }

  #{{ info_card_id }} .info-card__item--right {
    text-align: right;
  }

  #{{ info_card_id }} .info-card__icon {
    width: 4.6rem;
    height: 4.6rem;
    border-radius: {{ section.settings.icon_border_radius }}px;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.8rem;
  }

  #{{ info_card_id }} .info-card__icon svg {
    width: 2.4rem;
    height: 2.4rem;
    display: block;
  }

  #{{ info_card_id }} .info-card__icon path,
  #{{ info_card_id }} .info-card__icon circle,
  #{{ info_card_id }} .info-card__icon line,
  #{{ info_card_id }} .info-card__icon polyline {
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #{{ info_card_id }} .info-card__title {
    margin: 0 0 0.6rem;
    color: rgb(var(--color-foreground));
  }

  #{{ info_card_id }} .info-card__text {
    margin: 0;
    color: rgba(var(--color-foreground), 0.75);
  }

  @media screen and (min-width: 750px) {
    #{{ info_card_id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #{{ info_card_id }} .info-card {
      padding: 5.4rem 4rem;
    }

    #{{ info_card_id }} .info-card__grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    #{{ info_card_id }} .info-card__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<section id="{{ info_card_id }}" class="section color-{{ section.settings.background_color_scheme }}">
  <div class="page-width">
    <div class="info-card color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="info-card__inner">
        {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
          <div class="info-card__header info-card__header--{{ section.settings.header_text_alignment }}">
            {%- if section.settings.heading != blank -%}
              <{% if section.index == 1 %}h1{% else %}h2{% endif %} class="info-card__heading {{ section.settings.heading_size }}">
                {{ section.settings.heading }}
              </{% if section.index == 1 %}h1{% else %}h2{% endif %}>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <p class="info-card__subheading {{ section.settings.subheading_size }}">
                {{ section.settings.subheading }}
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="info-card__grid" role="list">
            {%- for block in section.blocks -%}
              <div
                class="info-card__item info-card__item--{{ section.settings.card_content_alignment }}"
                role="listitem"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.icon_svg != blank -%}
                  <div class="info-card__icon" aria-hidden="true">
                    {{ block.settings.icon_svg }}
                  </div>
                {%- endif -%}

                {%- if block.settings.custom_html_title != blank -%}
                  <div class="info-card__title {{ block.settings.title_size }}">
                    {{ block.settings.custom_html_title }}
                  </div>
                {%- elsif block.settings.title != blank -%}
                  <h3 class="info-card__title {{ block.settings.title_size }}">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <p class="info-card__text {{ block.settings.text_size }}">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

