{{ 'fc-how-hero.css' | asset_url | stylesheet_tag }}

<section class="fc-how-hero" aria-labelledby="HowHeroHeading-{{ section.id }}">
  <div class="fc-how-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fc-how-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 id="HowHeroHeading-{{ section.id }}" class="fc-how-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="fc-how-hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fc-how-hero__actions">
        {%- for block in section.blocks -%}
          {%- if block.type == 'action' and block.settings.heading != blank and block.settings.link != blank -%}
            {%- assign action_class = 'button button--primary fc-how-hero__action' -%}
            {%- if block.settings.style == 'secondary' -%}
              {%- assign action_class = 'button button--secondary fc-how-hero__action' -%}
            {%- endif -%}
            <a class="{{ action_class }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {{- block.settings.heading | escape -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How It Works — Hero",
  "tag": "section",
  "class": "section-fc-how-hero",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT WORKS" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Order Fresh Produce In Minutes, Not Phone Calls" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Four simple steps between browsing today’s stock and unpacking it in your kitchen. No accounts to chase, no quotes to wait on, no surprises on your invoice." }
  ],
  "blocks": [
    {
      "type": "action",
      "name": "Action",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Label", "default": "Start Your Order" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works — Hero",
      "blocks": [
        { "type": "action", "settings": { "heading": "Start Your Order", "link": "shopify://collections/all", "style": "primary" } },
        { "type": "action", "settings": { "heading": "View Products", "link": "shopify://collections/all", "style": "secondary" } }
      ]
    }
  ]
}
{% endschema %}
