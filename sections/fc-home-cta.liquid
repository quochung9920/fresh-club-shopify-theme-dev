{{ 'fc-home-cta.css' | asset_url | stylesheet_tag }}

<section class="fc-home-cta"{% if section.settings.heading != blank %} aria-labelledby="HomeCtaHeading-{{ section.id }}"{% endif %}>
  <div class="fc-home-cta__banner">
    <div class="fc-home-cta__background" aria-hidden="true">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 1600
          | image_tag:
            class: 'fc-home-cta__background-image',
            widths: '335, 670, 960, 1280, 1600',
            sizes: '(min-width: 1024px) 1280px, calc(100vw - 40px)',
            alt: '',
            loading: 'eager'
        }}
      {%- else -%}
        <img
          class="fc-home-cta__background-image"
          src="{{ 'freshclub-about-cta-bg.png' | asset_url }}"
          alt=""
          width="740"
          height="740"
          loading="eager"
        >
      {%- endif -%}
    </div>

    <div class="fc-home-cta__decoration fc-home-cta__decoration--left" aria-hidden="true">
      <img
        src="{{ 'freshclub-about-cta-decoration.png' | asset_url }}"
        alt=""
        width="206"
        height="165"
        loading="eager"
      >
    </div>
    <div class="fc-home-cta__decoration fc-home-cta__decoration--right" aria-hidden="true">
      <img
        src="{{ 'freshclub-about-cta-decoration.png' | asset_url }}"
        alt=""
        width="206"
        height="165"
        loading="eager"
      >
    </div>

    <div class="fc-home-cta__copy">
      <div class="fc-home-cta__title-group">
        {%- if section.settings.heading != blank -%}
          <h2 id="HomeCtaHeading-{{ section.id }}" class="fc-home-cta__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="fc-home-cta__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.text != blank -%}
        <p class="fc-home-cta__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      {%- assign button_url = section.settings.button_link | default: routes.all_products_collection_url -%}
      {%- assign button_class = 'button button--primary' -%}
      {%- if section.settings.button_style == 'secondary' -%}
        {%- assign button_class = 'button button--secondary' -%}
      {%- endif -%}
      <a class="{{ button_class }}" href="{{ button_url | escape }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home — Call to action",
  "tag": "section",
  "class": "section-fc-home-cta",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Save More. Plan better. Stay in Control."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Reliable supply. Transparent pricing. Consistent quality."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Whether you run a restaurants, cafe, catering company, juice bar, grocer, or office-FreshClub deliver the same wholesale access, quality assurance, and simplicity trusted by Sydney’s leading business."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Ordering Fresh"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    }
  ],
  "presets": [
    { "name": "Home — Call to action" }
  ]
}
{% endschema %}
